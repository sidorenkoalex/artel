# Курируемый .zshenv дома роли конвейера (НЕ .zshenv Оператора).
#
# Этот файл — часть референса docs/reference/role-home/ репозитория
# пульта: `init` разворачивает каталог codex/ референса в
# .artel/home/.codex/, и туда же смотрят CODEX_HOME и ZDOTDIR процесса
# роли (orchestrator/providers/codex.py). `doctor` сверяет развёрнутый слой
# с этим референсом и жёлтой строкой `codex-role-home` называет
# расхождение — в том числе пропажу этого файла.
#
# Зачем он нужен. Команды шага исполняет оболочка ВХОДА (`/bin/zsh -lc`), а
# macOS в такой оболочке читает /etc/zprofile с `path_helper`: тот собирает
# PATH из /etc/paths и /etc/paths.d, а прежние элементы PATH дописывает в
# ХВОСТ. Каталог .artel/venv/bin, который orchestrator/runner.py::role_env
# ставит ПЕРВЫМ, уезжал за /usr/bin — и голый `python3` внутри шага
# резолвился в системный 3.9 (инцидент 27.09: `python3 scripts/guard.py`
# упал на аннотациях с `|`, роль искала `python3.13` перебором).
#
# Почему именно так. $ZDOTDIR/.zshenv zsh читает ДО /etc/zprofile, а снятая
# опция GLOBAL_RCS запрещает ему читать остальные ГЛОБАЛЬНЫЕ файлы
# (/etc/zprofile, /etc/zshrc, /etc/zlogin). Это документированная опция
# оболочки, а не дописывание каталогов к чужому PATH: порядок каталогов,
# собранный пультом, сохраняется целиком. Вторая половина решения —
# `shell_environment_policy.inherit = "all"` соседнего config.toml (и та же
# пара флагом команды шага): без неё CLI не доносит до команды сам ZDOTDIR,
# и этот файл никто не прочитает.
#
# Ничего больше здесь быть не должно: .zshenv исполняется КАЖДОЙ оболочкой
# шага, и любая строка сверх необходимого — код, исполняемый на каждую
# команду роли.
unsetopt GLOBAL_RCS
